{
    "name": "nao-todo",
    "description": "NaoTodo, a simple TODO app, including web, mobile and desktop version",
    "version": "1.1.2",
    "author": "Nathan Lee",
    "license": "MIT",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@8.12.1",
    "scripts": {
        "webapp": "pnpm --filter @nao-todo/webapp",
        "mobile": "pnpm --filter @nao-todo/mobile",
        "desktop": "pnpm --filter @nao-todo/desktop"
    },
    "dependencies": {
        "@vitejs/plugin-vue": "^6.0.7",
        "axios": "^1.15.2",
        "dayjs": "^1.11.21",
        "dexie": "^4.4.2",
        "markdown-it": "^14.2.0",
        "moment": "^2.30.1",
        "nanoid": "^5.1.11",
        "nue-ui": "1.8.53",
        "nue-ui-iconfont": "0.2.6",
        "nue-ui-theme-shadlike": "0.11.22",
        "pinia": "^3.0.4",
        "spark-md5": "^3.0.2",
        "vue": "^3.5.34",
        "vue-i18n": "^11.4.4",
        "vue-router": "^5.0.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@nao-todo/application": "workspace:*",
        "@nao-todo/components": "workspace:*",
        "@nao-todo/desktop": "workspace:*",
        "@nao-todo/domain": "workspace:*",
        "@nao-todo/infrastructure": "workspace:*",
        "@nao-todo/types": "workspace:*",
        "@nao-todo/webapp": "workspace:*",
        "@rollup/plugin-terser": "^0.4.4",
        "@rushstack/eslint-patch": "^1.16.1",
        "@tsconfig/node20": "^20.1.9",
        "@types/markdown-it": "^14.1.2",
        "@types/node": "^20.19.41",
        "@types/spark-md5": "^3.0.5",
        "@types/validator": "^13.15.10",
        "@typescript-eslint/eslint-plugin": "^8.60.0",
        "@typescript-eslint/parser": "^8.60.0",
        "@vue/eslint-config-prettier": "^9.0.0",
        "@vue/tsconfig": "^0.5.1",
        "cross-env": "^7.0.3",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^9.1.2",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-vue": "^9.33.0",
        "font-slice": "^1.0.2",
        "globals": "^15.15.0",
        "nue-ui-resolver": "0.2.1",
        "prettier": "^3.8.3",
        "rollup-plugin-visualizer": "^5.14.0",
        "typescript": "~5.4.5",
        "typescript-eslint": "^8.60.0",
        "vite": "^8.0.14",
        "vue-tsc": "^2.2.12"
    },
    "workspaces": [
        "packages/*"
    ],
    "pnpm": {
        "overrides": {
            "tar@<7.5.7": ">=7.5.7",
            "tar@<=7.5.2": ">=7.5.3",
            "tar@<7.5.8": ">=7.5.8",
            "serialize-javascript@<=7.0.2": ">=7.0.3",
            "tar@<=7.5.9": ">=7.5.10",
            "tar@<=7.5.10": ">=7.5.11",
            "tar@<=7.5.3": ">=7.5.4",
            "fast-xml-parser@<5.7.0": ">=5.7.0",
            "serialize-javascript@>=5.0.0 <7.0.5": ">=7.0.5",
            "uuid@<11.1.1": ">=11.1.1"
        }
    }
}