{
    "name": "nao-todo",
    "description": "NaoTodo, a simple TODO app, including web, mobile and desktop version",
    "version": "1.1.3",
    "author": "Nathan Lee",
    "license": "MIT",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.18.0",
    "scripts": {
        "desktopapp": "pnpm --filter @nao-todo/desktopapp",
        "webapp": "pnpm --filter @nao-todo/webapp",
        "prepare": "vp config",
        "desktop:dev": "pnpm --filter @nao-todo/desktopapp dev",
        "desktop:build": "pnpm --filter @nao-todo/desktopapp build",
        "desktop:dist": "pnpm --filter @nao-todo/desktopapp dist"
    },
    "dependencies": {
        "@vitejs/plugin-vue": "^6.0.7",
        "axios": "^1.15.2",
        "dayjs": "^1.11.21",
        "dexie": "^4.4.2",
        "markdown-it": "^14.2.0",
        "moment": "^2.30.1",
        "nanoid": "^5.1.11",
        "nue-ui": "1.10.58",
        "nue-ui-iconfont": "0.2.6",
        "nue-ui-theme-shadlike": "0.13.24",
        "pinia": "^3.0.4",
        "vue": "^3.5.34",
        "vue-i18n": "^11.4.4",
        "vue-router": "^5.0.7"
    },
    "devDependencies": {
        "@nao-todo/desktopapp": "workspace:*",
        "@nao-todo/webapp": "workspace:*",
        "@nao-todo/domain-identity": "workspace:*",
        "@nao-todo/domain-project": "workspace:*",
        "@nao-todo/domain-tag": "workspace:*",
        "@nao-todo/domain-pomodoro": "workspace:*",
        "@nao-todo/domain-task": "workspace:*",
        "@nao-todo/domain-built-in-project": "workspace:*",
        "@nao-todo/infrastructure": "workspace:*",
        "@nao-todo/presentation": "workspace:*",
        "@nao-todo/presentation-identity": "workspace:*",
        "@nao-todo/shared": "workspace:*",
        "@configurajs/vite-plus": "^0.2.6",
        "@rollup/plugin-terser": "^0.4.4",
        "@rushstack/eslint-patch": "^1.16.1",
        "@tsconfig/node20": "^20.1.9",
        "@types/markdown-it": "^14.1.2",
        "@types/node": "^20.19.41",
        "@types/validator": "^13.15.10",
        "@vue/tsconfig": "^0.5.1",
        "cross-env": "^7.0.3",
        "font-slice": "^1.0.2",
        "globals": "^15.15.0",
        "nue-ui-resolver": "0.2.1",
        "rollup-plugin-visualizer": "^5.14.0",
        "typescript": "~5.4.5",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vue-tsc": "^2.2.12"
    },
    "workspaces": [
        "packages/*"
    ],
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.18.0",
            "onFail": "download"
        }
    }
}