{
    "name": "nao-todo",
    "description": "NaoTodo, a simple TODO app, including web, mobile and desktop version",
    "version": "1.22.1",
    "author": "Nathan Lee",
    "license": "MIT",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.18.0",
    "engines": {
        "node": ">=24.20.0"
    },
    "scripts": {
        "desktopapp": "pnpm --filter @nao-todo/desktopapp",
        "mobileapp": "pnpm --filter @nao-todo/mobileapp",
        "webapp": "pnpm --filter @nao-todo/webapp",
        "prepare": "vp config",
        "desktop:dev": "pnpm --filter @nao-todo/desktopapp dev",
        "desktop:build": "pnpm --filter @nao-todo/desktopapp build && node scripts/guard-dist-comments.mjs",
        "desktop:dist": "pnpm --filter @nao-todo/desktopapp dist",
        "guard:ddd": "node scripts/guard-domain-isolation.mjs",
        "guard:gate-pathspec": "node scripts/guard-gate-pathspec.mjs",
        "guard:barrel-imports": "node scripts/guard-barrel-imports.mjs",
        "guard:mobile-imports": "node scripts/guard-mobile-imports.mjs",
        "guard:test-location": "node scripts/guard-test-location.mjs",
        "guard:contrast": "node scripts/contrast-audit.mjs",
        "guard:dist-comments": "node scripts/guard-dist-comments.mjs",
        "guard:commit-scope": "node scripts/guard-commit-scope.mjs",
        "guard:audit": "node scripts/guard-audit.mjs",
        "guard:release-versions": "node scripts/verify-release-versions.mjs"
    },
    "dependencies": {
        "@vitejs/plugin-vue": "^6.0.7",
        "axios": "^1.15.2",
        "dayjs": "^1.11.21",
        "dexie": "^4.4.2",
        "nanoid": "^5.1.11",
        "nue-ui": "1.15.3",
        "nue-ui-iconfont": "0.2.6",
        "nue-ui-theme-shadlike": "0.13.30",
        "pinia": "^3.0.4",
        "vue": "^3.5.46",
        "vue-i18n": "^11.4.23",
        "vue-router": "^5.0.7"
    },
    "devDependencies": {
        "@nao-todo/desktopapp": "workspace:*",
        "@nao-todo/domain-built-in-project": "workspace:*",
        "@nao-todo/domain-identity": "workspace:*",
        "@nao-todo/domain-pomodoro": "workspace:*",
        "@nao-todo/domain-project": "workspace:*",
        "@nao-todo/domain-tag": "workspace:*",
        "@nao-todo/domain-task": "workspace:*",
        "@nao-todo/infrastructure": "workspace:*",
        "@nao-todo/mobileapp": "workspace:*",
        "@nao-todo/presentation": "workspace:*",
        "@nao-todo/presentation-identity": "workspace:*",
        "@nao-todo/shared": "workspace:*",
        "@nao-todo/webapp": "workspace:*",
        "@rollup/plugin-terser": "^0.4.4",
        "@tsconfig/node20": "^20.1.9",
        "@types/node": "^20.19.41",
        "@vue/test-utils": "^2.5.0",
        "globals": "^15.15.0",
        "jsdom": "^30.0.1",
        "rollup-plugin-visualizer": "^5.14.0",
        "typescript": "~5.4.5",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vue-tsc": "^2.2.12"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.18.0",
            "onFail": "download"
        }
    }
}