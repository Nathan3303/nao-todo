{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": [
        "src/**/*",
        "../../packages/**/*",
        "../../.bak/basic-bak"
    ],
    "exclude": [],
    "compilerOptions": {
        "composite": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "types": [
            "nue-ui/dist/global.d.ts"
        ],
        "rootDirs": [
            ".",
            "../../packages"
        ],
        "module": "esnext"
    }
}