{
    "name": "@nao-todo/desktop",
    "version": "0.0.1",
    "description": "Desktop version of NaoTodo",
    "author": "Nathan Lee",
    "license": "MIT",
    "private": true,
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "concurrently -k -n vite,electron -c cyan,green \"vite --config vite.config.ts\" \"wait-on tcp:5273 && cross-env NODE_ENV=development electron . --no-sandbox\"",
        "dev:renderer": "vite --config vite.config.ts",
        "build": "vite build --config vite.config.ts",
        "build:app": "vite build --config vite.config.ts && electron-builder",
        "preview": "vite preview --config vite.config.ts"
    },
    "build": {
        "appId": "com.naotodo.desktop",
        "productName": "NaoTodo",
        "files": [
            "dist/**/*",
            "electron/**/*"
        ],
        "directories": {
            "output": "release"
        }
    },
    "devDependencies": {
        "concurrently": "^9.1.0",
        "cross-env": "^7.0.3",
        "electron": "^33.2.1",
        "electron-builder": "^25.1.8",
        "wait-on": "^8.0.1"
    },
    "packageManager": "pnpm@8.12.1"
}
