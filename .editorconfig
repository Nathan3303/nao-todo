root = true

[*]
charset = utf-8
end_of_line = crlf
indent_size = 4
indent_style = space
insert_final_newline = false
max_line_length = 100
tab_width = 4

[{*.bash,*.sh,*.zsh}]
indent_size = 4
tab_width = 4

[{*.har,*.jsb2,*.jsb3,*.json,*.jsonc,*.postman_collection,*.postman_collection.json,*.postman_environment,*.postman_environment.json,.babelrc,.eslintrc,.prettierrc,.stylelintrc,.ws-context,jest.config}]
indent_size = 4

[{*.yaml,*.yml}]
indent_size = 4

# AGENTS.md 由 Vite+ CLI（`vp config` / prepare）托管注入 `<!--VITE PLUS START/END-->` 区块，
# 该注入器以 LF 写入且不读 .editorconfig ⇒ 与全局 CRLF 冲突造成 EOL 抖动。此处显式指定 LF 使三方一致。
[AGENTS.md]
end_of_line = lf
