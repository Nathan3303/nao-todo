{
    "$schema": "https://json.schemastore.org/tsconfig",
    // "include": [
    //     "./**/*.ts",
    //     "./*.ts"
    // ],
    "compilerOptions": {
        "composite": true,
        "incremental": true,
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "noEmitOnError": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "target": "esnext",
        "lib": [
            "es2015",
            "dom"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "rootDir": ".",
        "types": [
            "nue-ui/dist/global.d.ts"
        ]
    }
}
