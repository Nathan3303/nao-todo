/* ============================================================================
 * Design Tokens — 复制为 src/styles/tokens.css，按需裁剪。
 * 命名：--<prefix>-*（语义命名，非产品色名）；组件内一律 var(--<prefix>-*)。
 * 暗色/主题切换：在 :root 之外用媒体查询或 [data-theme] 覆盖令牌值即可。
 * ========================================================================== */
:root {
  /* 颜色（语义） */
  --color-bg: #ffffff;
  --color-surface: #f5f5f5;
  --color-surface-hover: #ececec;
  --color-border: #e0e0e0;
  --color-text: #1a1a1a;
  --color-text-muted: #666666;
  --color-text-disabled: #999999;

  --color-primary: #3b82f6;
  --color-primary-hover: #2563eb;
  --color-primary-text: #ffffff;
  --color-danger: #ef4444;
  --color-success: #10b981;
  --color-warning: #d4a72c;

  /* 间距（4px 基准） */
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-6: 24px;
  --space-8: 32px;
  --space-12: 48px;

  /* 圆角 */
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-full: 999px;

  /* 阴影 */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.12);

  /* 字号层级 */
  --text-xs: 12px;
  --text-sm: 14px;
  --text-md: 16px;
  --text-lg: 20px;
  --text-xl: 24px;

  /* 动效 */
  --dur-fast: 120ms;
  --dur-base: 200ms;
  --ease-base: ease;

  /* 布局 */
  --header-h: 56px;
  --sidebar-w: 240px;
  --content-max-w: 1080px;
  --gap-page: var(--space-6);
  --gap-card: var(--space-4);
}

/* 暗色模式：仅覆盖令牌值，组件零改动 */
@media (prefers-color-scheme: dark) {
  :root {
    --color-bg: #121212;
    --color-surface: #1e1e1e;
    --color-surface-hover: #262626;
    --color-border: #333333;
    --color-text: #f2f2f2;
    --color-text-muted: #a0a0a0;
    --color-text-disabled: #666666;
  }
}
